@@ -0,0 +1,171 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\Organization;
+use App\Models\Plan;
+use App\Models\PlanFeature;
+use App\Models\Subscription;
+use App\Services\SubscriptionService;
+use Illuminate\Foundation\Testing\DatabaseTransactions;
+use Illuminate\Support\Facades\DB;
+use Stripe\ApiRequestor;
+use Stripe\HttpClient\ClientInterface;
+use Tests\TestCase;
+
+/**
+ * HexaTech Loyalty and Content sold on their own (owner 2026-11-02; migration 2026_11_02_120000_add_module_plans):
+ * the plans the loyalty application moves a subscription between, hidden until Stripe can charge them, published by
+ * `stripe:sync --plan=… --publish`, and a plan change that never leaves Stripe charging the old price.
+ *
+ * Offline: a recording HTTP client answers Stripe. PostgreSQL only, like the other database tests here.
+ */
+class ModulePlansTest extends TestCase
+{
+    use DatabaseTransactions;
+
+    private ?object $previousHttpClient = null;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        if (DB::connection()->getDriverName() !== 'pgsql') {
+            $this->markTestSkipped('The SaaS schema is PostgreSQL-only; run with DB_CONNECTION=pgsql.');
+        }
+        config(['services.stripe.secret' => 'sk_test_offline_placeholder']);
+        $this->previousHttpClient = ApiRequestor::httpClient();
+    }
+
+    protected function tearDown(): void
+    {
+        ApiRequestor::setHttpClient($this->previousHttpClient);
+        parent::tearDown();
+    }
+
+    private function recorder(array $answers): object
+    {
+        $client = new class($answers) implements ClientInterface {
+            public array $requests = [];
+            public function __construct(private array $answers) {}
+            public function request($method, $absUrl, $headers, $params, $hasFile, $apiMode = 'v1', $maxNetworkRetries = null)
+            {
+                $this->requests[] = compact('method', 'absUrl', 'params');
+                return [json_encode(array_shift($this->answers)), 200, []];
+            }
+        };
+        ApiRequestor::setHttpClient($client);
+
+        return $client;
+    }
+
+    private function productsOf(string $slug): array
+    {
+        return Plan::where('slug', $slug)->firstOrFail()->planProducts()->with('product')->get()->pluck('product.slug')->sort()->values()->all();
+    }
+
+    private function feature(string $slug, string $key): ?string
+    {
+        $plan = Plan::where('slug', $slug)->firstOrFail();
+
+        return PlanFeature::where('planId', $plan->id)->whereHas('feature', fn ($q) => $q->where('key', $key))->value('value');
+    }
+
+    public function test_the_module_plans_exist_hidden_in_euros_with_their_products(): void
+    {
+        $this->assertTrue(DB::table('products')->where('slug', 'content')->where('isActive', true)->exists());
+
+        foreach (['loyalty' => 8500, 'content' => 8500, 'loyalty-content' => 17000] as $slug => $amount) {
+            $plan = Plan::where('slug', $slug)->firstOrFail();
+            $this->assertSame([$amount, 0, 'eur', 7, true, false], [$plan->monthlyAmount, $plan->yearlyAmount, $plan->currency, $plan->trialDays, $plan->isActive, $plan->isPublic], $slug);
+            $this->assertNull($plan->monthlyPriceId, "{$slug} has no Stripe price until stripe:sync makes one");
+        }
+        $this->assertSame(['loyalty'], $this->productsOf('loyalty'));
+        $this->assertSame(['content'], $this->productsOf('content'));
+        $this->assertSame(['content', 'loyalty'], $this->productsOf('loyalty-content'));
+
+        // Not in the public list a sign-up or a plan change reads, until published.
+        $listed = collect($this->getJson('/api/billing/plans')->assertOk()->json('plans'))->pluck('slug');
+        $this->assertNotContains('loyalty', $listed);
+        $this->assertNotContains('loyalty-content', $listed);
+    }
+
+    public function test_the_module_plans_grant_what_their_products_do(): void
+    {
+        if (!DB::table('features')->where('key', 'campaigns')->exists()) {
+            $this->markTestSkipped('This database has no feature rows (the seeder makes them).');
+        }
+        $this->assertSame('true', $this->feature('loyalty', 'campaigns'));
+        $this->assertSame('false', $this->feature('content', 'campaigns'));
+        $this->assertSame('true', $this->feature('loyalty-content', 'campaigns'));
+        $this->assertSame('false', $this->feature('loyalty-content', 'landing_pages'));
+    }
+
+    public function test_stripe_sync_prices_only_the_named_plans_and_publishes_them(): void
+    {
+        $growth = Plan::updateOrCreate(['slug' => 'growth'], ['name' => 'Growth', 'monthlyAmount' => 26900, 'yearlyAmount' => 269000, 'isActive' => true, 'isPublic' => true]);
+        $growthPrice = $growth->monthlyPriceId;
+        $http = $this->recorder([
+            ['object' => 'search_result', 'data' => [], 'has_more' => false, 'url' => '/v1/products/search'],
+            ['id' => 'prod_loyalty_test', 'object' => 'product'],
+            ['id' => 'price_loyalty_monthly_test', 'object' => 'price'],
+        ]);
+
+        $this->artisan('stripe:sync', ['--plan' => ['loyalty'], '--publish' => true])
+            ->expectsOutputToContain('Published')->assertSuccessful();
+
+        $plan = Plan::where('slug', 'loyalty')->firstOrFail();
+        $this->assertSame(['price_loyalty_monthly_test', null, true], [$plan->monthlyPriceId, $plan->yearlyPriceId, $plan->isPublic]);
+        $price = collect($http->requests)->first(fn ($r) => str_ends_with($r['absUrl'], '/v1/prices'));
+        $this->assertSame(8500, (int) $price['params']['unit_amount']);
+        $this->assertSame('eur', $price['params']['currency']);
+        $this->assertSame('month', $price['params']['recurring']['interval']);
+        $this->assertCount(3, $http->requests, 'one search, one product, one monthly price: no yearly price, no other plan');
+        $this->assertSame($growthPrice, $growth->fresh()->monthlyPriceId);
+        $this->assertFalse(Plan::where('slug', 'content')->value('isPublic'));
+    }
+
+    public function test_a_charged_subscription_never_moves_to_a_plan_without_a_price(): void
+    {
+        $org = Organization::create(['name' => 'Module Cafe', 'slug' => 'module-cafe-' . uniqid()]);
+        $from = Plan::where('slug', 'loyalty')->firstOrFail();
+        $from->update(['monthlyPriceId' => 'price_loyalty_test']);
+        $to = Plan::where('slug', 'loyalty-content')->firstOrFail();
+        $sub = Subscription::create(['organizationId' => $org->id, 'planId' => $from->id, 'status' => 'ACTIVE',
+            'stripeSubscriptionId' => 'sub_module_test_' . uniqid(), 'billingInterval' => 'MONTHLY',
+            'currentPeriodStart' => now(), 'currentPeriodEnd' => now()->addMonth()]);
+        $http = $this->recorder([]);
+
+        try {
+            app(SubscriptionService::class)->changePlan($sub, $to, 'MONTHLY');
+            $this->fail('A plan change with no Stripe price must be refused.');
+        } catch (\RuntimeException $e) {
+            $this->assertStringContainsString('no Stripe price', $e->getMessage());
+        }
+        $this->assertSame($from->id, $sub->fresh()->planId);
+        $this->assertSame([], $http->requests, 'Stripe was not asked');
+    }
+
+    public function test_a_charged_subscription_moves_to_the_larger_plans_price_prorated(): void
+    {
+        $org = Organization::create(['name' => 'Module Cafe', 'slug' => 'module-cafe-' . uniqid()]);
+        $from = Plan::where('slug', 'loyalty')->firstOrFail();
+        $to = Plan::where('slug', 'loyalty-content')->firstOrFail();
+        $to->update(['monthlyPriceId' => 'price_loyalty_content_test']);
+        $stripeId = 'sub_module_test_' . uniqid();
+        $sub = Subscription::create(['organizationId' => $org->id, 'planId' => $from->id, 'status' => 'ACTIVE',
+            'stripeSubscriptionId' => $stripeId, 'billingInterval' => 'MONTHLY',
+            'currentPeriodStart' => now(), 'currentPeriodEnd' => now()->addMonth()]);
+        $http = $this->recorder([
+            ['id' => $stripeId, 'object' => 'subscription', 'items' => ['object' => 'list', 'data' => [['id' => 'si_module_test', 'object' => 'subscription_item']]]],
+            ['id' => $stripeId, 'object' => 'subscription'],
+        ]);
+
+        app(SubscriptionService::class)->changePlan($sub, $to, 'MONTHLY');
+
+        $this->assertSame($to->id, $sub->fresh()->planId);
+        $update = $http->requests[1]['params'];
+        $this->assertSame([['id' => 'si_module_test', 'price' => 'price_loyalty_content_test']], $update['items']);
+        $this->assertSame('create_prorations', $update['proration_behavior']);
+        $this->assertSame('loyalty-content', $update['metadata']['plan_slug']);
+    }
+}
-- 
