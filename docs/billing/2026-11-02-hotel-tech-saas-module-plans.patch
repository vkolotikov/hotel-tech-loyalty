@@ -0,0 +1,173 @@
+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Support\Facades\DB;
+
+/**
+ * HexaTech Loyalty and HexaTech Content sold on their own (owner, 2026-11-02): 85 EUR a month each, both together
+ * 170 EUR, monthly, with the usual 7-day trial. The loyalty application (hotel-tech-loyalty, App\Support\PlanModules)
+ * gives an organisation whose plan holds only these products the matching workspaces and nothing else, and adds a
+ * product by moving the subscription to the plan of the larger set (change-plan, which Stripe prorates):
+ *
+ *   loyalty          → product loyalty            8 500 cents
+ *   content          → product content            8 500 cents
+ *   loyalty-content  → products loyalty, content 17 000 cents
+ *
+ * The plans are created HIDDEN (isPublic false) and without Stripe prices: a customer can neither sign up for one nor
+ * be moved to one until it can be charged. To sell them, once, in this application's environment:
+ *
+ *   php artisan stripe:sync --plan=loyalty --plan=content --plan=loyalty-content --publish
+ *
+ * (creates each plan's monthly Stripe price, saves it, then makes the plan public). No yearly price: yearlyAmount 0.
+ *
+ * Adds the product `content` (HexaTech Content, the AI social media planner), and `loyalty` where a database lacks
+ * the seeder's. Idempotent: a row that exists — a plan
+ * the owner already edited, a feature value set by hand — is left as it is.
+ */
+return new class extends Migration {
+    private function id(): string
+    {
+        return 'c' . base_convert((string) intval(microtime(true) * 1000), 10, 36) . bin2hex(random_bytes(8));
+    }
+
+    public function up(): void
+    {
+        $now = now();
+
+        // `loyalty` is the seeder's (DatabaseSeeder); made here only where a database lacks it.
+        DB::table('products')->insertOrIgnore([
+            'id'          => $this->id(),
+            'name'        => 'Loyalty',
+            'slug'        => 'loyalty',
+            'description' => 'Points-based loyalty program with rewards, tiers, and member portal',
+            'category'    => 'marketing',
+            'baseUrl'     => 'https://loyalty.hotel-tech.ai/login?token=',
+            'isActive'    => true,
+            'sortOrder'   => 3,
+            'createdAt'   => $now,
+            'updatedAt'   => $now,
+        ]);
+        DB::table('products')->insertOrIgnore([
+            'id'          => $this->id(),
+            'name'        => 'Content',
+            'slug'        => 'content',
+            'description' => 'HexaTech Content: AI social media planner with ideas, captions, images and a content calendar',
+            'category'    => 'marketing',
+            'baseUrl'     => 'https://app.hexa-tech.uk/content',
+            'isActive'    => true,
+            'sortOrder'   => 7,
+            'createdAt'   => $now,
+            'updatedAt'   => $now,
+        ]);
+        $products = DB::table('products')->whereIn('slug', ['loyalty', 'content'])->pluck('id', 'slug');
+
+        $plans = [
+            'loyalty' => [
+                'name'          => 'HexaTech Loyalty',
+                'description'   => 'HexaTech Loyalty on its own: members, tiers, points and stamps, rewards and offers, the member app and wallet cards, email, push and SMS campaigns.',
+                'monthlyAmount' => 8500,
+                'sortOrder'     => 10,
+                'products'      => ['loyalty'],
+            ],
+            'content' => [
+                'name'          => 'HexaTech Content',
+                'description'   => 'HexaTech Content on its own: the AI social media planner with ideas, captions, images, a content calendar and team approvals.',
+                'monthlyAmount' => 8500,
+                'sortOrder'     => 11,
+                'products'      => ['content'],
+            ],
+            'loyalty-content' => [
+                'name'          => 'HexaTech Loyalty + Content',
+                'description'   => 'HexaTech Loyalty and HexaTech Content together.',
+                'monthlyAmount' => 17000,
+                'sortOrder'     => 12,
+                'products'      => ['loyalty', 'content'],
+            ],
+        ];
+
+        foreach ($plans as $slug => $plan) {
+            DB::table('plans')->insertOrIgnore([
+                'id'             => $this->id(),
+                'name'           => $plan['name'],
+                'slug'           => $slug,
+                'description'    => $plan['description'],
+                'isBundle'       => count($plan['products']) > 1,
+                'monthlyPriceId' => null,
+                'yearlyPriceId'  => null,
+                'monthlyAmount'  => $plan['monthlyAmount'],
+                'yearlyAmount'   => 0,
+                'currency'       => 'eur',
+                'isActive'       => true,
+                'isPublic'       => false,
+                'trialDays'      => 7,
+                'sortOrder'      => $plan['sortOrder'],
+                'metadata'       => json_encode(['modules' => $plan['products'], 'sold_alone' => true]),
+                'createdAt'      => $now,
+                'updatedAt'      => $now,
+            ]);
+            $planId = DB::table('plans')->where('slug', $slug)->value('id');
+
+            foreach ($plan['products'] as $productSlug) {
+                if (!isset($products[$productSlug])) {
+                    continue;
+                }
+                DB::table('plan_products')->insertOrIgnore([
+                    'id'        => $this->id(),
+                    'planId'    => $planId,
+                    'productId' => $products[$productSlug],
+                ]);
+            }
+
+            // What the plan grants, as the loyalty application's fallback does (PlanModules::features): every
+            // feature there is, off unless the plan's products turn it on, limits the largest of its products'.
+            $features = DB::table('features')->pluck('id', 'key');
+            foreach ($this->featureValues($plan['products']) as $key => $value) {
+                if (!isset($features[$key])) {
+                    continue;
+                }
+                DB::table('plan_features')->insertOrIgnore([
+                    'id'        => $this->id(),
+                    'planId'    => $planId,
+                    'featureId' => $features[$key],
+                    'value'     => $value,
+                ]);
+            }
+        }
+    }
+
+    /** @return array<string, string> */
+    private function featureValues(array $products): array
+    {
+        $off = [
+            'ai_insights', 'ai_avatars', 'custom_branding', 'api_access', 'push_notifications', 'mobile_app', 'nfc_cards',
+            'time_management', 'admin_ai', 'brands', 'landing_pages', 'campaigns', 'reviews', 'engagement', 'wallet', 'chatbot',
+        ];
+        $values = array_fill_keys($off, 'false') + ['priority_support' => 'email'];
+        $byProduct = [
+            'loyalty' => [
+                'max_team_members' => '5', 'max_guests' => '2000', 'max_properties' => '1', 'max_loyalty_members' => '2000',
+                'push_notifications' => 'true', 'mobile_app' => 'true', 'nfc_cards' => 'true', 'campaigns' => 'true', 'wallet' => 'true',
+            ],
+            'content' => [
+                'max_team_members' => '5', 'max_guests' => '1000', 'max_properties' => '1', 'max_loyalty_members' => '0',
+            ],
+        ];
+        foreach ($products as $product) {
+            foreach ($byProduct[$product] ?? [] as $key => $value) {
+                if (str_starts_with($key, 'max_')) {
+                    $values[$key] = isset($values[$key]) ? (string) max((int) $values[$key], (int) $value) : $value;
+                } elseif ($value === 'true') {
+                    $values[$key] = 'true';
+                }
+            }
+        }
+
+        return $values;
+    }
+
+    public function down(): void
+    {
+        // Leaves the plans in place: an organisation may already be subscribed to one. Hide a plan in the
+        // super admin's Plans page instead.
+    }
+};
