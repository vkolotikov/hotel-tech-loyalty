+    /** HexaTech CRM on its own (owner 2026-11-07): the AI chat widget and the CRM, its own product, Loyalty's prices. */
+    public function test_crm_is_sold_in_three_packages_and_with_each_other_product_under_its_own_product(): void
+    {
+        $this->assertTrue(DB::table('products')->where('slug', 'crm_chat')->where('isActive', true)->exists());
+
+        $prices = [
+            'crm_lite' => 4900, 'crm' => 8500, 'crm_pro' => 14900,
+            'appointments-crm' => 17000, 'loyalty_pro-crm_lite' => 19800, 'content_lite-crm_pro' => 18800, 'content-crm' => 17000,
+        ];
+        foreach ($prices as $slug => $amount) {
+            $plan = Plan::where('slug', $slug)->firstOrFail();
+            $this->assertSame([$amount, (int) round($amount * 12 * 0.85), 'eur', 7, true, false], [$plan->monthlyAmount, $plan->yearlyAmount, $plan->currency, $plan->trialDays, $plan->isActive, $plan->isPublic], $slug);
+            $this->assertNull($plan->monthlyPriceId, "{$slug} has no Stripe price until stripe:sync makes one");
+        }
+        $this->assertSame('HexaTech Loyalty Pro + HexaTech CRM Lite', Plan::where('slug', 'loyalty_pro-crm_lite')->value('name'));
+        // Never the full suite's `crm` or `chat`: those make a full customer in the loyalty application.
+        $this->assertSame(['crm_chat'], $this->productsOf('crm'));
+        $this->assertSame(['crm_chat', 'loyalty'], $this->productsOf('loyalty-crm'));
+        $this->assertSame(['appointments', 'booking', 'crm_chat'], $this->productsOf('appointments_pro-crm'));
+        $this->assertNull(Plan::where('slug', 'crm-loyalty')->first(), 'a slug names its products in module order');
+        $this->assertNull(Plan::where('slug', 'loyalty-content-crm')->first(), 'three products is the full suite');
+        $this->assertEquals(['content' => 'lite', 'crm' => 'pro'], Plan::where('slug', 'content_lite-crm_pro')->firstOrFail()->metadata['packages'] ?? null);
+
+        // The migration makes the feature rows it needs where a database lacks them.
+        $this->assertSame(['true', 'true'], [$this->feature('crm_lite', 'chatbot'), $this->feature('crm_lite', 'engagement')]);
+        $this->assertSame(['1000', '2500', '6000'], [$this->feature('crm_lite', 'ai_monthly_cost_cents'), $this->feature('crm', 'ai_monthly_cost_cents'), $this->feature('crm_pro', 'ai_monthly_cost_cents')]);
