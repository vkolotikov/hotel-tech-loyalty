+
+    public function up(): void
+    {
+        $now = now();
+
+        foreach (self::FEATURE_ROWS as $key => [$name, $type]) {
+            DB::table('features')->insertOrIgnore([
+                'id' => $this->id(), 'productId' => null, 'key' => $key, 'name' => $name, 'valueType' => $type, 'createdAt' => $now,
+            ]);
+        }
+        $features = DB::table('features')->pluck('id', 'key');
+
+        DB::table('products')->insertOrIgnore([
+            'id'          => $this->id(),
+            'name'        => 'HexaTech CRM',
+            'slug'        => 'crm_chat',
+            'description' => 'HexaTech CRM: the AI chat widget for the website, the live inbox, leads, the pipeline, contacts and tasks',
