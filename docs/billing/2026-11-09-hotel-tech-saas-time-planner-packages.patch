+
+    /** key => [name, valueType], as DatabaseSeeder names them (made only where a database lacks them). */
+    private const FEATURE_ROWS = [
+        'max_team_members' => ['Team Members', 'LIMIT'], 'max_guests' => ['Guest Profiles', 'LIMIT'],
+        'max_properties' => ['Properties', 'LIMIT'], 'max_loyalty_members' => ['Loyalty Members', 'LIMIT'],
+        'max_booking_staff' => ['Team members who can be booked', 'LIMIT'],
+        'ai_monthly_cost_cents' => ['Monthly AI allowance (USD cents)', 'LIMIT'],
+        'ai_insights' => ['AI Insights & Chatbot', 'BOOLEAN'], 'ai_avatars' => ['AI Virtual Concierge', 'BOOLEAN'],
+        'custom_branding' => ['Custom Branding & Theme', 'BOOLEAN'], 'api_access' => ['API Access', 'BOOLEAN'],
+        'push_notifications' => ['Push Notifications', 'BOOLEAN'], 'mobile_app' => ['Member Mobile App', 'BOOLEAN'],
+        'nfc_cards' => ['NFC Card Support', 'BOOLEAN'], 'priority_support' => ['Support Level', 'TIER'],
+        'time_management' => ['Time Management Platform', 'BOOLEAN'], 'admin_ai' => ['Staff AI Copilot', 'BOOLEAN'],
+        'brands' => ['Multi-Brand Portfolios', 'BOOLEAN'], 'landing_pages' => ['Landing Page Builder', 'BOOLEAN'],
+        'campaigns' => ['Campaigns', 'BOOLEAN'], 'reviews' => ['Reviews', 'BOOLEAN'], 'engagement' => ['Engagement', 'BOOLEAN'],
+        'wallet' => ['Wallet Passes', 'BOOLEAN'], 'chatbot' => ['AI Chatbot', 'BOOLEAN'],
+    ];
+
+    private const SWITCHES = [
+        'ai_insights', 'ai_avatars', 'custom_branding', 'api_access', 'push_notifications', 'mobile_app', 'nfc_cards',
+        'time_management', 'admin_ai', 'brands', 'landing_pages', 'campaigns', 'reviews', 'engagement', 'wallet', 'chatbot',
+    ];
+
+    private function id(): string
+    {
+        return 'c' . base_convert((string) intval(microtime(true) * 1000), 10, 36) . bin2hex(random_bytes(8));
+    }
+
+    public function up(): void
+    {
+        $now = now();
+
+        foreach (self::FEATURE_ROWS as $key => [$name, $type]) {
+            DB::table('features')->insertOrIgnore([
+                'id' => $this->id(), 'productId' => null, 'key' => $key, 'name' => $name, 'valueType' => $type, 'createdAt' => $now,
+            ]);
+        }
+        $features = DB::table('features')->pluck('id', 'key');
+
+        DB::table('products')->insertOrIgnore([
+            'id'          => $this->id(),
+            'name'        => 'HexaTech Time Planner',
+            'slug'        => 'time_planner',
+            'description' => 'HexaTech Time Planner: the team\'s day and week planner with AI plans, reviews, capture and voice',
+            'category'    => 'time',
+            'baseUrl'     => 'https://app.hexa-tech.uk/time',
+            'isActive'    => true,
+            'sortOrder'   => 10,
+            'createdAt'   => $now,
+            'updatedAt'   => $now,
+        ]);
+        $products = DB::table('products')->whereIn('slug', ['appointments', 'booking', 'loyalty', 'content', 'crm_chat', 'time_planner'])->pluck('id', 'slug');
+
+        $sort = 110;
+        foreach ($this->choices() as $choice) {
+            $slug = $this->slug($choice);
+            $monthly = array_sum(array_map(fn ($m, $p) => self::PACKAGES[$m][$p][0], array_keys($choice), $choice));
+            $values = $this->features($choice);
+            $row = [
+                'name'          => $this->name($choice),
+                'description'   => implode(' and ', array_map(fn ($m, $p) => self::NAMES[$m] . ' ' . ucfirst($p), array_keys($choice), $choice))
+                    . ' on its own plan; 15 % less a month paid yearly.',
+                'isBundle'      => count($choice) > 1,
+                'monthlyAmount' => $monthly,
+                'yearlyAmount'  => (int) round($monthly * 12 * (100 - self::YEARLY_DISCOUNT_PERCENT) / 100),
+                'currency'      => 'eur',
+                'trialDays'     => 7,
+                'sortOrder'     => $sort++,
+                'metadata'      => json_encode(['modules' => array_keys($choice), 'packages' => $choice, 'sold_alone' => true]),
+                'updatedAt'     => $now,
+            ];
+
+            $existing = DB::table('plans')->where('slug', $slug)->first();
+            if ($existing) {
+                // Only a plan nobody can be on yet takes the packages' terms; one already sold stays as its owner set it.
+                if ($existing->isPublic || $existing->monthlyPriceId || $existing->yearlyPriceId) {
+                    Log::warning('add_time_planner_packages: plan already sold, left as it is', ['slug' => $slug]);
+                    continue;
+                }
+                DB::table('plans')->where('id', $existing->id)->update($row);
+                $planId = $existing->id;
+                // A hidden plan made earlier under this slug keeps only this choice's products: a full product left on it
+                // would make its holders full customers in the loyalty application.
+                $own = array_values(array_filter(array_map(fn ($p) => $products[$p] ?? null, array_merge(...array_map(fn ($m) => self::PRODUCTS[$m], array_keys($choice))))));
+                DB::table('plan_products')->where('planId', $planId)->whereNotIn('productId', $own)->delete();
+                foreach ($values as $key => $value) {
+                    if (!isset($features[$key])) {
+                        continue;
+                    }
+                    $updated = DB::table('plan_features')->where('planId', $planId)->where('featureId', $features[$key])->update(['value' => $value]);
+                    if ($updated === 0) {
+                        DB::table('plan_features')->insertOrIgnore(['id' => $this->id(), 'planId' => $planId, 'featureId' => $features[$key], 'value' => $value]);
+                    }
+                }
+            } else {
+                $planId = $this->id();
+                DB::table('plans')->insert($row + [
+                    'id' => $planId, 'slug' => $slug, 'monthlyPriceId' => null, 'yearlyPriceId' => null,
+                    'isActive' => true, 'isPublic' => false, 'createdAt' => $now,
+                ]);
+                foreach ($values as $key => $value) {
+                    if (isset($features[$key])) {
+                        DB::table('plan_features')->insertOrIgnore(['id' => $this->id(), 'planId' => $planId, 'featureId' => $features[$key], 'value' => $value]);
+                    }
+                }
+            }
+            foreach (array_keys($choice) as $module) {
+                foreach (self::PRODUCTS[$module] as $product) {
+                    if (isset($products[$product])) {
+                        DB::table('plan_products')->insertOrIgnore(['id' => $this->id(), 'planId' => $planId, 'productId' => $products[$product]]);
+                    }
+                }
+            }
+        }
+    }
+
+    /** The Time Planner in each package, then with Appointments, Loyalty, Content and CRM in every pair of packages, in module order. */
+    private function choices(): array
+    {
+        $out = [];
+        foreach (array_keys(self::PACKAGES['time']) as $package) {
+            $out[] = ['time' => $package];
+        }
+        foreach (['appointments', 'loyalty', 'content', 'crm'] as $other) {
+            foreach (array_keys(self::PACKAGES[$other]) as $package) {
+                foreach (array_keys(self::PACKAGES['time']) as $time) {
+                    $out[] = [$other => $package, 'time' => $time];
+                }
+            }
+        }
+
+        return $out;
+    }
+
+    /** The loyalty application's PlanModules::planSlug: Standard is the bare name, products in order with a hyphen. */
+    private function slug(array $choice): string
+    {
+        return implode('-', array_map(fn ($m, $p) => $p === 'standard' ? $m : "{$m}_{$p}", array_keys($choice), $choice));
+    }
+
+    /** "HexaTech CRM Pro + HexaTech Time Planner": PlanModules::planName. */
+    private function name(array $choice): string
+    {
+        return implode(' + ', array_map(fn ($m, $p) => self::NAMES[$m] . ($p === 'standard' ? '' : ' ' . ucfirst($p)), array_keys($choice), $choice));
+    }
+
+    /**
+     * What a choice grants: every switch off unless a package turns it on, the largest limits, the highest support —
+     * and the sum of the AI allowances (PlanModules::features).
+     */
+    private function features(array $choice): array
+    {
+        $values = array_fill_keys(self::SWITCHES, 'false') + ['priority_support' => 'email'];
+        foreach ($choice as $module => $package) {
+            foreach (self::PACKAGES[$module][$package][1] as $key => $value) {
+                if ($key === 'ai_monthly_cost_cents') {
+                    $values[$key] = isset($values[$key]) ? (string) ((int) $values[$key] + (int) $value) : $value;
+                } elseif (str_starts_with($key, 'max_')) {
+                    $values[$key] = isset($values[$key]) ? (string) max((int) $values[$key], (int) $value) : $value;
+                } elseif ($key === 'priority_support') {
+                    $values[$key] = $value === 'priority' ? 'priority' : $values[$key];
+                } elseif ($value === 'true') {
+                    $values[$key] = 'true';
+                }
+            }
+        }
+
+        return $values;
+    }
+
+    public function down(): void
+    {
+        // Leaves the plans in place: an organisation may already be subscribed to one.
+    }
+};
