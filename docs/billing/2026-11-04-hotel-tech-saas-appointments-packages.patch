+    /** HexaTech Appointments on its own (owner 2026-11-04): Loyalty's prices, its own packages, the same trial. */
+    public function test_appointments_is_sold_in_three_packages_and_with_each_other_product(): void
+    {
+        $this->assertTrue(DB::table('products')->where('slug', 'appointments')->where('isActive', true)->exists());
+
+        $prices = [
+            'appointments_lite' => 4900, 'appointments' => 8500, 'appointments_pro' => 14900,
+            'appointments-loyalty' => 17000, 'appointments_lite-content_pro' => 19800, 'appointments_pro-loyalty_lite' => 19800,
+        ];
+        foreach ($prices as $slug => $amount) {
+            $plan = Plan::where('slug', $slug)->firstOrFail();
+            $this->assertSame([$amount, (int) round($amount * 12 * 0.85), 'eur', 7, true, false], [$plan->monthlyAmount, $plan->yearlyAmount, $plan->currency, $plan->trialDays, $plan->isActive, $plan->isPublic], $slug);
+            $this->assertNull($plan->monthlyPriceId, "{$slug} has no Stripe price until stripe:sync makes one");
+        }
+        $this->assertSame(['appointments', 'booking'], $this->productsOf('appointments'));
+        $this->assertSame(['appointments', 'booking', 'loyalty'], $this->productsOf('appointments-loyalty'));
+        $this->assertSame(['appointments', 'booking', 'content'], $this->productsOf('appointments_pro-content_lite'));
+        $this->assertSame(['2', '5', '15'], [$this->feature('appointments_lite', 'max_booking_staff'), $this->feature('appointments', 'max_booking_staff'), $this->feature('appointments_pro', 'max_booking_staff')]);
+        $this->assertSame('2', $this->feature('appointments_lite-loyalty_pro', 'max_booking_staff'));
+        $this->assertNull(Plan::where('slug', 'appointments-loyalty-content')->first(), 'all three products is the full suite');
+        $this->assertSame(['appointments' => 'lite', 'loyalty' => 'pro'], Plan::where('slug', 'appointments_lite-loyalty_pro')->firstOrFail()->metadata['packages'] ?? null);
+
+        $listed = collect($this->getJson('/api/billing/plans')->assertOk()->json('plans'))->pluck('slug');
+        $this->assertNotContains('appointments_lite', $listed);
+    }
+
