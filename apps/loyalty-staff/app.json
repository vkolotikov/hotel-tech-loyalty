{
  "expo": {
    "name": "HexaTech Staff",
    "slug": "hexatech-loyalty-staff",
    "owner": "hoteltechai",
    "version": "1.0.2",
    "scheme": "hexatech-staff",
    "orientation": "portrait",
    "icon": "./assets/brand-icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07090f",
    "ios": {
      "bundleIdentifier": "uk.hexatech.loyalty.staff",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "The camera reads members' QR codes.",
        "NFCReaderUsageDescription": "NFC reads members' loyalty cards.",
        "NSFaceIDUsageDescription": "Face ID unlocks the app on a shared desk phone.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "uk.hexatech.loyalty.staff",
      "adaptiveIcon": {
        "backgroundColor": "#07090f",
        "foregroundImage": "./assets/brand-emblem.png"
      },
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand-icon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand-emblem.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#07090f"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "The camera reads members' QR codes.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID unlocks the app on a shared desk phone."
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "NFC reads members' loyalty cards.",
          "includeNdefEntitlement": false
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#c9a84c"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "aacc3c67-7f27-487d-842b-4fe6b923034b"
      }
    }
  }
}
