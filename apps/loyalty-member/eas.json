{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.hexa-tech.uk/api",
        "EXPO_PUBLIC_WEB_URL": "https://app.hexa-tech.uk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.hexa-tech.uk/api",
        "EXPO_PUBLIC_WEB_URL": "https://app.hexa-tech.uk"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.hexa-tech.uk/api",
        "EXPO_PUBLIC_WEB_URL": "https://app.hexa-tech.uk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6765608479",
        "appleTeamId": "HNWSAQ5CQ9"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
